{
  "version": 3,

  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Configure a Debug build using Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_PLAYGROUND": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Configure a Release build using Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_PLAYGROUND": "OFF"
      }
    },
    {
      "name": "playground",
      "displayName": "Release",
      "description": "Playground configured as release using Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-playground",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_PLAYGROUND": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "debug",
      "jobs": 4
    },
    {
      "name": "build-release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "build-playground",
      "configurePreset": "playground",
      "jobs": 4
    }
  ]
}